# AI Voice Studio 环境变量示例
#
# 只列变量名和占位值，请勿在此文件或仓库中写入真实密钥。
# 真实值请在 Vercel → Project → Settings → Environment Variables 中配置。
# 第一阶段不需要配置任何变量，页面和接口骨架都可以直接运行。

# ---- 仅服务端（绝不能出现在前端代码中） ----
ELEVENLABS_API_KEY=your-elevenlabs-api-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_AUDIO_BUCKET=generated-audio

# 共享限流 / 幂等存储（推荐 Upstash Redis）
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ---- 可公开给前端（受 RLS 保护） ----
# 第二阶段由 /api/config 之类的接口下发给前端，用于 Supabase Auth 登录
SUPABASE_ANON_KEY=your-supabase-anon-key
