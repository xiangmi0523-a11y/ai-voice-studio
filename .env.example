# 访问密码：打开网页时要输入。不填则任何人都能打开（不建议）。
APP_PASSWORD=

# Replicate 的 API Token（https://replicate.com/account/api-tokens）。
# 暂时没有就留空，App 能打开，但"训练"和"生成翻唱"按钮会提示未配置。
REPLICATE_API_TOKEN=

# Vercel Blob 存储的令牌。在 Vercel 项目里连接 Blob 存储后会自动添加，一般不用手填。
BLOB_READ_WRITE_TOKEN=

# 可选：换用别的 Replicate 模型，格式 owner/name 或 owner/name:version
# REPLICATE_TRAIN_MODEL=replicate/train-rvc-model
# REPLICATE_COVER_MODEL=zsxkib/realistic-voice-cloning
